# Training service (Step 2) — environment configuration.
# Copy to `.env` (or export) and adjust. Defaults below match the bundled
# docker-compose MinIO + MLflow instances.

# Shared DVC repo owned by the Data Management service.
#   local dev:  ../data-management/data
#   docker:     a shared volume mounted at /app/data
DATA_REPO=../data-management/data

# MLflow tracking server.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=catdog

# MinIO credentials injected into `dvc pull` (remote config carries url/endpoint).
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Default hyper-parameters (overridable per POST /train).
TRAIN_EPOCHS=10
TRAIN_BATCH_SIZE=8
TRAIN_LEARNING_RATE=0.001
TRAIN_IMAGE_SIZE=160