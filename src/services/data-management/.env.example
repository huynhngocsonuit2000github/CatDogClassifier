# Copy to `.env` / export as needed. Defaults mirror the bundled docker-compose MinIO.

# Object storage: "s3" (MinIO) or "local" (dev on disk)
STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=datasets
S3_REGION=us-east-1

# DVC: "auto" | "required" | "disabled"
DVC_MODE=auto
DVC_REMOTE_NAME=minio
DVC_REMOTE_PATH=dvc

# Directory hosting the DVC repo + datasets
DATA_DIR=./data

# Upload size cap (MiB)
MAX_UPLOAD_MB=512