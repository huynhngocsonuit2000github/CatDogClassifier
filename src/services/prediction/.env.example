# MLflow tracking/registry server (local). In docker-compose this is
# http://mlflow:5000 — the container name on the shared network.
MLFLOW_TRACKING_URI=http://localhost:5000

# Registered-model name to serve. Must match Training's REGISTER_MODEL_NAME.
REGISTER_MODEL_NAME=CatDogClassifier

# Input size the model was trained on (do not change unless retraining).
IMAGE_SIZE=160

# Sigmoid decision boundary: probability >= this value is classified as "dog".
PREDICT_THRESHOLD=0.5

# SQLite file for the prediction history (created on first start).
PREDICTIONS_DB_PATH=./data/predictions.db